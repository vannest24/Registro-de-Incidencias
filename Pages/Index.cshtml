@page
@model IndexModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Registro de daños a equipos de cómputo</title>
    
    <!-- Script de Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 m-0 p-0">

    <!-- From Uiverse.io by iZOXVL --> 
    <div class="flex items-center justify-center min-h-screen">
      <div class="max-w-lg w-full">
        <div
          style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);"
          class="bg-gray-600 rounded-lg shadow-xl overflow-hidden"
        >
          <div class="p-8">
            <h2 class="text-center text-3xl text-blue-100 font-sans: Arial font-medium ">
              Bienvenido de nuevo
            </h2>
            <p class="mt-4 text-center text-blue-100 font-sans: Arial">Inicia sesión para continuar</p>

            <!-- Errores especificos manejados por el servidor -->
            @if (!ModelState.IsValid) {

              <div class = "mt-4 rounded-md bg-red-900/40 border border-red-500 px-4 py-3 text-sm text-red-200 font-semibold" role="alert">
              @Html.ValidationSummary(false)
              </div>
            }




            <form id="loginForm" method="post" class="mt-8 space-y-6">
              @Html.AntiForgeryToken()


              <div class="rounded-md shadow-sm">

                <div>
                  <label class="sr-only" for="email">Correo electrónico</label>
                  <input
                    placeholder="Correo electrónico"
                    class="appearance-none relative block w-full px-3 py-3 border border-blue-700 bg-gray-700 text-white rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                    required=""
                    autocomplete="username"
                    type="email"
                    name="Email"
                    id="email"
                  />

                </div>
                <div class="mt-4 relative">
                  <label class="sr-only" for="password">Contraseña</label>
                  <input
                    placeholder="Contraseña"
                    class="appearance-none relative block w-full px-3 py-3 border border-blue-700 bg-gray-700 text-white rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                    required=""
                    autocomplete="current-password"
                    type="password"
                    name="Password"
                    id="password"
                  />
                  <button 
                    type="button"
                    id="togglePasswordBtn"
                    aria-label="Mostrar contraseña"
                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-blue-100 hover:text-white"
                    >👁️</button>

                </div>
              </div>

              <div class="flex items-center justify-between mt-4">
                <div class="flex items-center">
                  <input
                    class="h-4 w-4 text-indigo-500 focus:ring-indigo-400 border-gray-600 rounded"
                    type="checkbox"
                    name="remember-me"
                    id="remember-me"
                  />
                  <label class="ml-2 block text-sm text-gray-100" for="remember-me"
                    >Mantener sesión iniciada</label
                  >
                </div>
              </div>

              <div>
                <button
                  class="group relative w-full flex justify-center py-3 px-4 border border-indigo-900 text-sm font-medium rounded-md text-gray-900 bg-indigo-500 hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                  type="submit"
                  id="submitBtn"
                >
                  Iniciar sesión
                </button>
              </div>
            </form>
          
          <!-- Espacio para agregar otros metodos, ejemplo: la recuperacion de contraseña -->
          

          </div>
        </div>
      </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordInput = document.getElementById('password');
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const loginForm = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');

            // Lógica para el botón "Mostrar/Ocultar" contraseña
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                this.textContent = isPassword ? '🙈' : '👁️';
                this.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });

            // Feedback: Deshabilitar botón durante el procesamiento
            loginForm.addEventListener('submit', function (e) {
                // Usamos setTimeout para dejar que el POST se envíe ANTES de apagar el botón
                setTimeout(() => {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Iniciando sesión...';
                }, 10);
            });
    </script>

</body>
</html>